# DeskMate Environment Variables Example
# Copy this file to .env and fill in the values. Do not commit .env to version control!

# Anthropic API Key for Claude
ANTHROPIC_API_KEY=sk-ant-correct-key-here

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# MongoDB Database Name (defaults to deskmate)
MONGO_DB_NAME=deskmate

# OpenRouter Configuration (Alternative / Fallback)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-2.0-flash-001
